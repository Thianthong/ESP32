#include <WiFi.h>
#include <PubSubClient.h>
#include <WiFiClientSecure.h>

// WiFi
const char* ssid = "realme7Pro";
const char* password = "";

// MQTT
const char* mqtt_server = "10c02f943311455693ac3bafdd2412fa.s1.eu.hivemq.cloud";
const char* mqtt_user = "Thianthong";
const char* mqtt_pass = "Man@12345";
const int mqtt_port = 8883;
// topic
const char* topic_pub = "topicpub";
const char* topic_sub = "topicsub";

WiFiClientSecure espClient;
PubSubClient client(espClient);

// 📩 รับข้อความ (callback)
void callback(char* topic, byte* payload, unsigned int length) {
  Serial.print("Message from topic: ");
  Serial.println(topic);

  String msg = "";
  for (int i = 0; i < length; i++) {
    msg += (char)payload[i];  // 🔥 แปลง byte → string
  }

  Serial.print("Message: ");
  Serial.println(msg);

  // ตัวอย่าง: ถ้าส่ง "on"
  if (msg == "on") {
    Serial.println("LED ON (จำลอง)");
  } else if (msg == "off") {
    Serial.println("LED OFF (จำลอง)");
  }
}

// ต่อ WiFi
void setup_wifi() {
  Serial.print("Connecting WiFi...");
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi Connected!");
}

// ต่อ MQTT
void reconnect() {
  while (!client.connected()) {
    Serial.print("Connecting MQTT...");

    if (client.connect("ESP32Client", mqtt_user, mqtt_pass)) {
      Serial.println("Connected!");

      // 📥 subscribe ตอน connect สำเร็จ
      client.subscribe(topic_sub);

    } else {
      Serial.print("Failed, rc=");
      Serial.print(client.state());
      delay(2000);
    }
  }
}
// setup ต่างๆ
void setup() {
  Serial.begin(115200);

  setup_wifi();

  espClient.setInsecure();

  client.setServer(mqtt_server, mqtt_port);

  client.setCallback(callback);

  randomSeed(analogRead(0)); // 🎲 seed random
}

void loop() {
  //MQTT ทำงานเรื่อยๆ
  if (!client.connected()) {
    reconnect();
  }

  client.loop();

  // 🎲 สุ่มค่า
  float temp = random(250, 350) / 10.0;

  client.publish(topic_pub, String(temp).c_str());

  Serial.print("Send temp: ");
  Serial.println(temp);

  delay(2000);
}
